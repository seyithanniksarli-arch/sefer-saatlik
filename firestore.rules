rules_version = '2';
// Sefer Sırası – satılık sürüm güvenlik kuralları
// Her durak sadece kendi verisini görür.
service cloud.firestore {
  match /databases/{database}/documents {

    function girisli() { return request.auth != null; }
    function sahip() { return girisli() && request.auth.token.email == "seyithanniksarli@gmail.com"; }
    function kullanici() { return get(/databases/$(database)/documents/kullanicilar/$(request.auth.uid)).data; }
    function kahya(d) {
      return girisli() && exists(/databases/$(database)/documents/kullanicilar/$(request.auth.uid))
        && kullanici().rol == 'kahya' && kullanici().durak == d;
    }
    function cihaz(d) { return /databases/$(database)/documents/duraklar/$(d)/cihazlar/$(request.auth.uid); }
    function onayli(d) { return girisli() && exists(cihaz(d)) && get(cihaz(d)).data.onay == true; }
    function yetkili(d) { return sahip() || kahya(d) || onayli(d); }
    function yonetici(d) { return sahip() || kahya(d); }

    // Kahya hesapları: sadece sahip oluşturur, herkes kendi kaydını okur
    match /kullanicilar/{uid} {
      allow read: if sahip() || (girisli() && request.auth.uid == uid);
      allow write: if sahip();
    }

    match /duraklar/{d} {
      // Durağın adı, ayarları ve durak konumları: herkes okur (yolcu sayfası için), sadece kahya/sahip yazar
      allow get: if true;
      allow list: if girisli();
      allow create, delete: if sahip();
      allow update: if yonetici(d);

      // Şoför telefonları
      match /cihazlar/{uid} {
        allow read: if yonetici(d) || (girisli() && request.auth.uid == uid);
        // Şoför sadece kendine, onaysız istek açabilir
        allow create: if yonetici(d) || (girisli() && request.auth.uid == uid
                        && request.resource.data.onay == false && request.resource.data.plaka == '');
        allow update: if yonetici(d) || (girisli() && request.auth.uid == uid
                        && request.resource.data.onay == resource.data.onay
                        && request.resource.data.plaka == resource.data.plaka);
        allow delete: if yonetici(d) || (girisli() && request.auth.uid == uid);
      }

      // Günlük listeler
      match /gunler/{tarih} {
        allow read: if yetkili(d);
        allow write: if yonetici(d);
      }

      // Şoförlerin "sıradan çıktım / sıraya girdim" kayıtları: şoför sadece kendi plakasını değiştirebilir
      match /sira/{tarih} {
        allow read: if yetkili(d);
        allow write: if yonetici(d) || (onayli(d) && (resource == null
          ? request.resource.data.keys().hasOnly([get(cihaz(d)).data.plaka])
          : request.resource.data.diff(resource.data).affectedKeys().hasOnly([get(cihaz(d)).data.plaka])));
      }

      // Plaka kilidi (bir plakayı aynı anda tek telefon takip eder)
      match /takip/{plaka} {
        allow read, write: if yetkili(d);
      }

      // Canlı konum: yolcular herkes okur, sadece onaylı telefon yazar
      match /canli/{plaka} {
        allow read: if true;
        allow write: if yetkili(d);
      }

      // Trafik öğrenme havuzu (hat başına bir belge): durağın bütün şoförlerinin gerçek durak-arası süreleri.
      // Yolcu sayfası okur, onaylı şoför telefonları (ve kahya/sahip) yazar. Her durak yalnızca kendi havuzunu görür/yazar.
      match /ogren/{hat} {
        allow read: if true;
        allow create, update: if yetkili(d) && request.resource.data.keys().hasOnly(['s']);
        allow delete: if yonetici(d);
      }

      // Yolcu sayfası için yayımlanan sefer planı
      match /plan/{tarih} {
        allow read: if true;
        allow write: if yetkili(d);
      }
    }
  }
}
